# Default provider: Anthropic Claude.
ANTHROPIC_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5-5

# Any LiteLLM provider: set its provider/model and use the generic key below.
LLM_API_KEY=
LLM_API_BASE=
LLM_API_KEY_ENV=

# auto uses credentials or a local endpoint; demo forces sample conversations;
# live enables provider-native credential flows (for example cloud IAM).
LLM_MODE=auto
# schema uses structured output; json works with plain chat endpoints.
LLM_OUTPUT_MODE=schema
